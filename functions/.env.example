# =============================================================
# Mirante Radar — Variáveis de Ambiente (Cloud Functions)
# Copie este arquivo para functions/.env e preencha os valores
# NUNCA commite o functions/.env com valores reais
#
# Secrets sensíveis (tokens de API, chaves) ficam no
# Google Secret Manager — não aqui.
# =============================================================

# --- Cloud Tasks ---
# Service account com permissão cloudtasks.tasks.create
TASKS_SA_EMAIL=radar-tasks@radarimirante.iam.gserviceaccount.com

# Região onde a fila Cloud Tasks está criada
TASKS_LOCATION=southamerica-east1

# Nome da fila no Cloud Tasks
TASKS_QUEUE=radar-analysis

# URL da função analyzePost (gerada após o primeiro deploy)
ANALYZE_POST_URL=https://analyzepost-HASH-rj.a.run.app
